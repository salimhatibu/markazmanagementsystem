{
  "name": "markaz-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ke.mombasa.markaz.desktop",
    "productName": "Markaz",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.8",
    "minimatch@^10.0.0": "^11.0.8"
  }
}
